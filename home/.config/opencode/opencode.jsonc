{
  "$schema": "https://opencode.ai/config.json",
  // Auto-approve tool calls in every session. Per-tool "*" rules are needed
  // because OpenCode's built-in per-tool defaults ("ask") beat a bare "allow".
  // Using objects (not strings) keeps OpenCode's built-in "deny" rules for
  // .env files, its auth/service files, and remote tunnelling.
  "permission": {
    "*": "allow",
    "bash": { "*": "allow" },
    "edit": { "*": "allow" },
    "webfetch": "allow",
    "external_directory": { "*": "allow" },
    "doom_loop": "allow"
  },
  "mcp": {
    // Cloudflare internal MCP portal; authenticate with `opencode mcp auth cf-portal`
    // (the fish `oc` alias does this on every launch).
    "cf-portal": {
      "type": "remote",
      "url": "https://portal.mcp.cfdata.org/mcp",
      "enabled": true
    }
  }
}
